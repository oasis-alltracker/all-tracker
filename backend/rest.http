//----------W O R K O U T   E N T R I E S----------
//-------------------------------------------
//Fitness entries: entryType "movement" (quick log) or "workout" (session with exercise entries).
//Both take an optional reflection:
//effortDescriptor: easy | steady | hard | pushed_it | gentle | exhausting
//bodyFeelDescriptor: energized | strong | tired | sore | clear | calm | depleted | lighter

//Get workout entries for one day (movements and workouts).
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries?dateStamp=20230208
Authorization: Bearer token
###

//Get workout entries for multiple days (includes endDate).
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries?startDate=20230208&endDate=20230210
Authorization: Bearer token
###

//Create movement entry.
//activityType: walk | run | yoga | swim | stretch | cycle | other (other needs activityLabel)
POST https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries
Authorization: Bearer token

{
    "entryType": "movement",
    "activityType": "other",
    "activityLabel": "Climbing",
    "durationMinutes": 45,
    "effortDescriptor": "hard",
    "bodyFeelDescriptor": "energized",
    "note": "New route.",
    "season": "building",
    "time": "18:30",
    "dateStamp": "20230208"
}
###

//Create workout entry (start of session; returns { ID } for its exercise entries).
POST https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries
Authorization: Bearer token

{
    "entryType": "workout",
    "name": "Push day",
    "season": "building",
    "time": "12:00",
    "dateStamp": "20230208",
    "workoutPlanID": "b4bd9480-ac14-11ed-aeb4-516f1c8bdaab"
}
###

//Update workout entry: end-of-workout reflection (null clears a field).
//Workouts: name, workoutPlanID, time + reflection. Movements: activityType, activityLabel, durationMinutes, time + reflection.
PUT https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries/20230209-65fb8d40-aa55-11ed-bfee-c93f00eb950c
Authorization: Bearer token

{
    "effortDescriptor": "pushed_it",
    "bodyFeelDescriptor": "strong",
    "note": "New bench PR."
}
###

//Delete workout entry (also deletes its exercise entries).
DELETE https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/workoutEntries/20230208-d8f0d960-ac1f-11ed-85ac-276c9faf893c
Authorization: Bearer token
###



//----------E X E R C I S E   E N T R I E S----------
//-------------------------------------------
//Get exercise entries for a given workout (in position order).
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/exerciseEntries?workoutEntryID=20230208-d8f0d960-ac1f-11ed-85ac-276c9faf893c
Authorization: Bearer token
###

//Get exercise entries for one day.
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/exerciseEntries?dateStamp=20230208
Authorization: Bearer token
###

//Get exercise entries for multiple days (e.g. past page), grouped by workout then position.
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/exerciseEntries?startDate=20230201&endDate=20230228
Authorization: Bearer token
###

//Create exercise entry. The same exercise can be logged more than once per workout.
//Returns { ID } = workoutEntryID-exerciseEntryID.
POST https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/exerciseEntries
Authorization: Bearer token

{
    "name": "Pull-ups",
    "exerciseID": "c81c88b0-ac14-11ed-83ff-bbb6a057b089",
    "workoutEntryID": "20230208-d8f0d960-ac1f-11ed-85ac-276c9faf893c",
    "position": 0,
    "setInfo": [ {
        "weight": 30,
        "reps": 34,
        "time": "ehdfh"
    }]

}
###

//Update exercise entry (setInfo and/or position). ID is workoutEntryID-exerciseEntryID.
PUT https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/exerciseEntries/20230208-d8f0d960-ac1f-11ed-85ac-276c9faf893c-e1a2b3c0-ac14-11ed-83ff-bbb6a057b089
Authorization: Bearer token

{
    "setInfo": [ {
        "weight": 33,
