//----------------H A B I T S----------------
//-------------------------------------------
//Get all habits.
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits
Authorization: Bearer token
###

//Get active (or closed) habits.
GET https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits?status=active
Authorization: Bearer token
###

//Create habit.
POST https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits
Authorization: Bearer token

{
    "name": "Wash Shoes",
    "isPositive": true,
    "threshold": 1,
    "pngURL": "url",
    "time": "13:00"
}
###

//Create habit, recording the season and day it starts in (relaunch app).
POST https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits
Authorization: Bearer token

{
    "name": "Wash Shoes",
    "isPositive": true,
    "threshold": 1,
    "pngURL": "url",
    "season": "building",
    "dateStamp": "20261113"
}
###

//Close habit. Saves this chapter's completions (total and by season) on the history event.
PUT https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits/62962c80-a773-11ed-8679-d7059b0ed0d6
Authorization: Bearer token

{
    "status": "closed",
    "season": "building",
    "dateStamp": "20261113"
}
###

//Reopen habit.
PUT https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits/62962c80-a773-11ed-8679-d7059b0ed0d6
Authorization: Bearer token

{
    "status": "active",
    "season": "restoring",
    "dateStamp": "20261114"
}
###

//Update habit.
PUT https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits/62962c80-a773-11ed-8679-d7059b0ed0d6
Authorization: Bearer token

{
    "name": "Wash Shoes",
    "isPositive": true,
    "threshold": 2,
    "pngURL": "url",
    "time": "15:00"
}
###

//Delete habit.
DELETE https://8svmwrf55j.execute-api.ca-central-1.amazonaws.com/dev/v1/habits/8eedc320-29ed-11f0-88bc-0d736b0ef0a6
Authorization: Bearer token
